+// Pulsar patch: see `ts_wasm_store__instantiate`.
+typedef struct {
+  wasmtime_global_t global;
+  const wasm_name_t *name;
+  bool is_function;
+} GotEntry;
+
+static bool ts_wasm_store__resolve_got_entries(
+  TSWasmStore *self,
+  wasmtime_instance_t *instance,
+  uint32_t memory_base,
+  const void *entries_pointer,
+  char **error_message
+) {
+  const Array(GotEntry) *entries = entries_pointer;
+  wasmtime_context_t *context = wasmtime_store_context(self->store);
+  wasmtime_error_t *error = NULL;
+  uint32_t appended_functions = 0;
+
+  for (unsigned i = 0; i < entries->size; i++) {
+    const GotEntry *entry = &entries->contents[i];
+    wasmtime_extern_t export;
+    bool found = wasmtime_instance_export_get(
+      context, instance, entry->name->data, entry->name->size, &export
+    );
+    int32_t value;
+
+    if (entry->is_function) {
+      if (found && export.kind == WASMTIME_EXTERN_FUNC) {
+        // Give the function a slot in the shared table.
+        wasmtime_val_t function_ref = {.kind = WASMTIME_FUNCREF, .of.funcref = export.of.func};
+        uint64_t slot;
+        error = wasmtime_table_grow(context, &self->function_table, 1, &function_ref, &slot);
+        if (error) {
+          wasmtime_error_delete(error);
+          format(error_message, "failed to add GOT.func entry '%.*s'", (int)entry->name->size, entry->name->data);
+          return false;
+        }
+        appended_functions++;
+        value = (int32_t)slot;
+      } else {
+        bool in_stdlib = false;
+        for (unsigned j = 0; j < array_len(STDLIB_SYMBOLS); j++) {
+          if (name_eq(entry->name, STDLIB_SYMBOLS[j])) {
+            value = (int32_t)self->stdlib_fn_indices[j];
+            in_stdlib = true;
+            break;
+          }
+        }
+        if (!in_stdlib) {
+          format(error_message, "unresolved GOT.func entry '%.*s'", (int)entry->name->size, entry->name->data);
+          return false;
+        }
+      }
+    } else {
+      if (!found || export.kind != WASMTIME_EXTERN_GLOBAL) {
+        format(error_message, "unresolved GOT.mem entry '%.*s'", (int)entry->name->size, entry->name->data);
+        return false;
+      }
+      // Exported data symbols are offsets from the module's memory base.
+      wasmtime_val_t offset;
+      wasmtime_global_get(context, &export.of.global, &offset);
+      value = (int32_t)memory_base + offset.of.i32;
+    }
+
+    wasmtime_val_t global_value = WASM_I32_VAL(value);
+    error = wasmtime_global_set(context, &entry->global, &global_value);
+    ts_assert(!error);
+  }
+
+  self->current_function_table_offset += appended_functions;
+  return true;
+}
